{
  "id": "dialog-renderer-categories",
  "description": "Preserve scoped dialog and renderer lifecycle categories without retrying an uncertain input.",
  "fixture": "test/fixtures/input-reliability/index.html",
  "grant": ["http://127.0.0.1:18321", "http://127.0.0.1:18322"],
  "steps": [
    { "tool": "browser.session.start", "expect": "completed" },
    {
      "tool": "browser.act",
      "expect": "dialog_blocked",
      "action": { "kind": "click", "target": { "role": "button", "name": "Dialog on mousedown" } }
    },
    { "tool": "browser.act", "expect": "completed", "action": { "kind": "dialog_dismiss" } },
    {
      "tool": "browser.act",
      "expect": "completed",
      "action": { "kind": "click", "target": { "role": "button", "name": "Set asynchronous value" } }
    },
    {
      "tool": "browser.wait_for",
      "expect": "completed",
      "waitFor": { "state": "visible", "text": "settled-without-delay" }
    }
  ],
  "forbid": []
}
