{
  "manifest_version": 3,
  "name": "Newton Browser",
  "short_name": "Newton",
  "version": "0.3.0",
  "description": "Local browser control bridge for agents.",
  "action": {
    "default_title": "Newton Browser",
    "default_popup": "dist/panel.html"
  },
  "background": {
    "service_worker": "dist/src/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "debugger",
    "scripting",
    "storage",
    "tabs",
    "tabGroups"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/src/overlay.js",
        "dist/src/overlay.css"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
