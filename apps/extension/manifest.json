{
  "manifest_version": 3,
  "name": "Newton Browser",
  "short_name": "Newton",
  "version": "0.4.5",
  "description": "Local browser control bridge for agents.",
  "action": {
    "default_title": "Newton Browser",
    "default_popup": "dist/panel.html",
    "default_icon": {
      "16": "icons/action-disconnected-16.png",
      "32": "icons/action-disconnected-32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dist/src/overlay.js",
        "dist/src/overlay.css"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "dist/src/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "debugger",
    "scripting",
    "storage",
    "tabs",
    "tabGroups"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
