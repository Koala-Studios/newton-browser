{
  "name": "newton-browser-workspace",
  "version": "0.4.3",
  "license": "MIT",
  "private": true,
  "description": "Local-only browser control for MCP clients using an existing Chrome or Edge profile.",
  "homepage": "https://github.com/Koala-Studios/newton-browser#readme",
  "bugs": {
    "url": "https://github.com/Koala-Studios/newton-browser/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Koala-Studios/newton-browser.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "boundary:check": "node scripts/verify-boundary.mjs",
    "build:core": "pnpm --filter @newton-browser/core build",
    "build:driver": "pnpm --filter @newton-browser/driver build",
    "build:mcp": "pnpm --filter newton-browser build",
    "extension:build": "node scripts/build-extension.mjs",
    "extension:artifact": "pnpm extension:build && node scripts/build-extension-artifact.mjs",
    "build": "pnpm build:core && pnpm build:driver && pnpm build:mcp && pnpm extension:build",
    "pack:check": "node scripts/pack-check.mjs",
    "smoke:quick": "node --test --test-isolation=none test/fixtures/fixture.test.ts apps/mcp-server/test/file-validation.test.ts",
    "smoke:matrix": "node scripts/smoke/matrix.mjs",
    "smoke:chaos": "node scripts/smoke/chaos.mjs",
    "smoke:stress": "node --expose-gc scripts/smoke/stress.mjs",
    "smoke:multi-client": "node scripts/smoke/multi-client.mjs",
    "smoke:clean-user": "node scripts/smoke/clean-user.mjs",
    "smoke:real-browser": "node scripts/smoke/standalone-live-qa.mjs",
    "smoke:current-tab": "node scripts/smoke/current-tab-live-qa.mjs",
    "smoke:cold-starts": "node scripts/smoke/cold-start-distribution.mjs",
    "smoke:real-clients": "node scripts/smoke/real-clients.mjs",
    "smoke:extension-ready": "node scripts/smoke/extension-readiness.mjs",
    "release:check": "node scripts/release-check.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node scripts/run-tests.mjs",
    "lint": "pnpm boundary:check"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "sharp": "^0.35.3",
    "typescript": "^5.9.0"
  }
}
